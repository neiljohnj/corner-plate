<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CornerPlate.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="https://github.com/projektanker/icons.avalonia"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="CornerPlate.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        xmlns:models="using:CornerPlate.Models"
        Icon="/Assets/avalonia-logo.ico"
        Title="CornerPlate">


    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        
        <Style Selector="ListBox.sidebar">
            <Setter Property="Background" Value="#202A30"></Setter>
            <Setter Property="Width" Value="70" />
            <Setter Property="Padding" Value="0,56,0,0" />
        </Style>

        <Style Selector="ListBox.sidebar > ListBoxItem">
            <Setter Property="Padding" Value="0,16" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="ListBox.selectable ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#02022d" />
        </Style>

        <Style Selector="ListBox.selectable ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#BC4E18" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="ListBox.order-type-bar">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style Selector="ListBox.order-type-bar > ListBoxItem">
            <Setter Property="Padding" Value="20,12" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
        </Style>
    </Window.Styles>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        
        <ListBox Classes="sidebar selectable" SelectedIndex="0" ItemsSource="{Binding NavItems}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:NavItem">
                    <StackPanel Orientation="Vertical" Spacing="12">
                        <i:Icon Value="{Binding Icon}" FontSize="24"/>
                        <TextBlock
                            Text="{Binding Text}"
                            FontWeight="SemiBold"
                            FontSize="9"
                            HorizontalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            
            <Border Padding="24,12" Background="White"
                    BoxShadow="0 2 8 0 #1A000000"
                    ZIndex="1"
                    >
                <Grid Classes="top-bar" Grid.Row="0">                
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <i:Icon Value="fa-solid fa-plate-wheat" 
                                Foreground="#020d22" 
                                FontSize="24" />
                        <TextBlock Text="{Binding AppName}" 
                                   FontWeight="SemiBold"
                                   Foreground="#020d22"
                                   FontSize="24"
                                   />
                    </StackPanel>

                    <ListBox Grid.Column="1" 
                             Classes="order-type-bar selectable" 
                             ItemsSource="{Binding OrderTypeItems}"
                             SelectedIndex="0"
                             HorizontalAlignment="Center"
                             >
                        
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:OrderTypeItem">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <i:Icon Value="{Binding Icon}" FontSize="14"/>
                                    <TextBlock 
                                        Text="{Binding Text}"
                                        FontSize="14"
                                        />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16"
                        VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <i:Icon Value="fa-solid fa-circle" FontSize="6" Foreground="#16a34a" />
                            <TextBlock Text="Connected" FontSize="12" Foreground="#16a34a" />
                        </StackPanel>

                        <Border Width="1" Height="24" Background="#D0D0D0" />

                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <i:Icon Value="fa-solid fa-user" FontSize="12" />
                            <TextBlock Text="Name · Position" FontSize="12" />
                            <i:Icon Value="fa-solid fa-chevron-down" FontSize="10" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Background="WhiteSmoke" />
        </Grid>
    </Grid>
</Window>
